# ---------------------------------------------------------------- database
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Use the pooler (port 6543), NOT the direct connection on 5432: serverless
# functions open far more connections than a direct Postgres will tolerate.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# -------------------------------------------------------------------- auth
# Any random 32+ byte secret. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → your OAuth 2.0 Client ID.
# The authorised redirect URI must be <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only addresses on this domain may sign in. Enforced in the signIn callback and
# again by the employees_domain_check trigger in the database.
ALLOWED_EMAIL_DOMAIN=convegenius.ai
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=convegenius.ai

# Set this in production so Auth.js builds callback URLs against the public
# domain rather than the internal one. Vercel sets VERCEL_URL, but that is the
# deployment URL, not necessarily the one users visit.
# AUTH_URL=https://your-domain.example.com
