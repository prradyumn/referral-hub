# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The "Publishable key" (starts with sb_publishable_). The older "anon public"
# key from the Legacy tab also works. Both are safe in the browser — row-level
# security is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Only addresses on this domain may sign in. Must match the allowed_email_domain
# row in the app_settings table.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=convegenius.ai

NEXT_PUBLIC_SITE_URL=http://localhost:3000
