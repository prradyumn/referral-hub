# ---------------------------------------------------------------- database
# Any PostgreSQL 14+ connection string. Prefer your provider's POOLED host:
# serverless functions open far more connections than a direct Postgres tolerates.
# Create the schema with:  psql "$DATABASE_URL" -f db/0001_schema.sql
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# -------------------------------------------------------------------- auth
# Any random 32+ byte secret. Generate with: npx auth secret
AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → your OAuth 2.0 Client ID.
# The authorised redirect URI must be <your-origin>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only addresses on this domain may sign in. Enforced in the signIn callback and
# again by the employees_domain_check trigger in the database.
ALLOWED_EMAIL_DOMAIN=convegenius.ai

# Set this in production so Auth.js builds callback URLs against the public
# domain rather than the internal one. Vercel sets VERCEL_URL, but that is the
# deployment URL, not necessarily the one users visit.
# AUTH_URL=https://your-domain.example.com

# ------------------------------------------------------------------- keka
#
# Keka is the ATS (Keka Hire), HRIS and payroll system. All three values below
# come from ONE screen and ALL THREE are required — a client ID and secret
# without the API key will not authenticate.
#
#   Keka → Global admin settings → Integrations & Automations
#        → API access → API key
#
# Only a **Global admin** can issue these. No other admin role can.
#
# When you create the key:
#   · Grant ONLY the recruitment scopes. The Hub reads jobs and candidates and
#     writes candidates. It never needs salaries, attendance, documents,
#     performance or expenses — and a referral tool holding a key that can read
#     payroll widens the blast radius of a leak for no benefit.
#     `npm run keka:verify` audits this for you and names anything over-granted.
#   · Turn on "Set expiry" and give it one. Keys default to never expiring.
#   · Name it for the environment, e.g. "Referral Hub — production", so it can
#     be revoked without guessing what else it might break.
#   · Issue SEPARATE keys for sandbox and production. Never put a production
#     key in a local .env.local.
#
# Handling:
#   · Run `npm run env:set` rather than editing this by hand. It strips the
#     trailing full stop that a secret copied out of prose brings with it — an
#     hour was lost to exactly that once already (CONTEXT.md §8) — and writes
#     the file 0600.
#   · NEVER prefix any of these with NEXT_PUBLIC_. That ships them to browsers.
#   · `.gitignore` covers `.env*`, so .env.local is not committable. Keep it
#     that way; do not add an exception.
#   · If a value ever lands somewhere shared — a chat, a ticket, a screenshot —
#     treat it as burned and issue a new key. Rotation is cheap; a leaked key
#     that can read the HRIS is not.

# The subdomain only. If your Keka URL is acme.keka.com, this is "acme" —
# not the full host, and no https://.
KEKA_COMPANY=

KEKA_CLIENT_ID=
KEKA_CLIENT_SECRET=
KEKA_API_KEY=

# "production" (default) or "sandbox". Sandbox talks to *.kekademo.com and
# needs its own separate credential — production keys do not work there.
KEKA_ENV=production

# ------------------------------------------------------------------- cron
# Shared secret protecting /api/cron/keka, which runs the sync.
# Generate with:  openssl rand -base64 32
# The route refuses EVERY request when this is unset — it does not default
# open — and compares it in constant time.
CRON_SECRET=
